<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BRobbDetector.ViewModels"
        xmlns:views="using:BRobbDetector.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="BRobbDetector.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="BRobbDetector - 标注框颜色检测"
        Width="1100" Height="720">

  <TabControl>
    <TabItem Header="检测 Detection">
      <Grid ColumnDefinitions="300,*" Margin="8">
        <ScrollViewer Grid.Column="0">
        <StackPanel Spacing="8">

          <TextBlock Text="输入目录 (图片)" FontWeight="Bold" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding InputDirectory}" Watermark="Select input folder..." />
            <Button Grid.Column="1" Content="..." Margin="4,0,0,0" Click="OnPickInputDir" />
          </Grid>

          <TextBlock Text="输出目录 (JSON)" FontWeight="Bold" Margin="0,8,0,0" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" Watermark="Select output folder..." />
            <Button Grid.Column="1" Content="..." Margin="4,0,0,0" Click="OnPickOutputDir" />
          </Grid>

          <Separator Margin="0,8,0,0" />
          <TextBlock Text="颜色规则 (标注框颜色)" FontWeight="Bold" Margin="2,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,4,0,2">
            <Button Content="+ 添加类别" Command="{Binding AddCategoryCommand}" Padding="4,2" />
            <Button Content="自动求阈值" Command="{Binding AutoColorThresholdCommand}" Padding="4,2" />
            <Button Content="还原" Command="{Binding RestoreColorDefaultsCommand}" Padding="4,2" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding TypeCategories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="3" Padding="4" Margin="0,0,0,4">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="类别名称" FontSize="11" />
                      <ComboBox Grid.Column="1" SelectedIndex="{Binding TargetColorIndex}" Margin="4,0,4,0" VerticalAlignment="Center" MinWidth="50">
                        <ComboBoxItem Content="黑" />
                        <ComboBoxItem Content="灰" />
                        <ComboBoxItem Content="白" />
                        <ComboBoxItem Content="红" />
                        <ComboBoxItem Content="橙" />
                        <ComboBoxItem Content="黄" />
                        <ComboBoxItem Content="绿" />
                        <ComboBoxItem Content="青" />
                        <ComboBoxItem Content="蓝" />
                        <ComboBoxItem Content="紫" />
                      </ComboBox>
                      <Button Grid.Column="2" Content="✕" Padding="4,2"
                              Click="OnRemoveCategory" Tag="{Binding}" />
                    </Grid>
                    <Grid ColumnDefinitions="14,*,30,*,30" Margin="0,2,0,0">
                      <TextBlock Grid.Column="0" Text="H" FontSize="10" VerticalAlignment="Center" />
                      <Slider Grid.Column="1" Minimum="0" Maximum="180" Value="{Binding HueLow}" TickFrequency="10" />
                      <TextBlock Grid.Column="2" Text="{Binding HueLow}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      <Slider Grid.Column="3" Minimum="0" Maximum="180" Value="{Binding HueHigh}" TickFrequency="10" />
                      <TextBlock Grid.Column="4" Text="{Binding HueHigh}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="14,*,30,*,30" Margin="0,1,0,0">
                      <TextBlock Grid.Column="0" Text="S" FontSize="10" VerticalAlignment="Center" />
                      <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding SatMin}" TickFrequency="16" />
                      <TextBlock Grid.Column="2" Text="{Binding SatMin}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      <Slider Grid.Column="3" Minimum="0" Maximum="255" Value="{Binding SatMax}" TickFrequency="16" />
                      <TextBlock Grid.Column="4" Text="{Binding SatMax}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="14,*,30,*,30" Margin="0,1,0,0">
                      <TextBlock Grid.Column="0" Text="V" FontSize="10" VerticalAlignment="Center" />
                      <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ValMin}" TickFrequency="16" />
                      <TextBlock Grid.Column="2" Text="{Binding ValMin}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      <Slider Grid.Column="3" Minimum="0" Maximum="255" Value="{Binding ValMax}" TickFrequency="16" />
                      <TextBlock Grid.Column="4" Text="{Binding ValMax}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Separator Margin="0,8,0,0" />
          <TextBlock Text="降噪阈值" FontWeight="Bold" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
            <Button Content="还原" Command="{Binding RestoreDenoiseDefaultsCommand}" Padding="4,2" />
          </StackPanel>
          <Grid ColumnDefinitions="50,*,30,*,30" Margin="0,2,0,0">
            <TextBlock Grid.Column="0" Text="字形" FontSize="10" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="5" Maximum="80" Value="{Binding TextGlyphMaxSize}" TickFrequency="2" />
            <TextBlock Grid.Column="2" Text="{Binding TextGlyphMaxSize}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Slider Grid.Column="3" Minimum="50" Maximum="2000" Value="{Binding TextGlyphMaxArea}" TickFrequency="50" />
            <TextBlock Grid.Column="4" Text="{Binding TextGlyphMaxArea}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="50,*,30,*,30" Margin="0,1,0,0">
            <TextBlock Grid.Column="0" Text="开运算" FontSize="10" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="5" Maximum="50" Value="{Binding LineOpenLength}" TickFrequency="5" />
            <TextBlock Grid.Column="2" Text="{Binding LineOpenLength}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Slider Grid.Column="3" Minimum="1" Maximum="30" Value="{Binding LineOpenStep}" TickFrequency="2" />
            <TextBlock Grid.Column="4" Text="{Binding LineOpenStep}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Grid>

          <Separator Margin="0,8,0,0" />
          <TextBlock Text="孔洞检测" FontWeight="Bold" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,2">
            <Button Content="自动求阈值" Command="{Binding AutoThresholdCommand}" Padding="4,2" />
            <Button Content="还原" Command="{Binding RestoreDefaultsCommand}" Padding="4,2" />
          </StackPanel>
          <Grid ColumnDefinitions="50,*,30,*,30" Margin="0,2,0,0">
            <TextBlock Grid.Column="0" Text="孔面积" FontSize="10" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="50" Maximum="100000" Value="{Binding HoleMinArea}" TickFrequency="500" />
            <TextBlock Grid.Column="2" Text="{Binding HoleMinArea}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Slider Grid.Column="3" Minimum="50" Maximum="100000" Value="{Binding HoleMaxArea}" TickFrequency="500" />
            <TextBlock Grid.Column="4" Text="{Binding HoleMaxArea}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="50,*,30,*,30" Margin="0,1,0,0">
            <TextBlock Grid.Column="0" Text="边长" FontSize="10" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="5" Maximum="500" Value="{Binding HoleMinSide}" TickFrequency="5" />
            <TextBlock Grid.Column="2" Text="{Binding HoleMinSide}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Slider Grid.Column="3" Minimum="5" Maximum="500" Value="{Binding HoleMaxSide}" TickFrequency="5" />
            <TextBlock Grid.Column="4" Text="{Binding HoleMaxSide}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="50,*,30,*,30" Margin="0,1,0,0">
            <TextBlock Grid.Column="0" Text="填充率" FontSize="10" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="10" Maximum="100" Value="{Binding HoleMinFillPercent}" TickFrequency="5" />
            <TextBlock Grid.Column="2" Text="{Binding HoleMinFillPercent}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Slider Grid.Column="3" Minimum="10" Maximum="100" Value="{Binding HoleMaxFillPercent}" TickFrequency="5" />
            <TextBlock Grid.Column="4" Text="{Binding HoleMaxFillPercent}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="50,*,30,*,30" Margin="0,1,0,0">
            <TextBlock Grid.Column="0" Text="支撑率" FontSize="10" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="10" Maximum="100" Value="{Binding HoleMinSupportPercent}" TickFrequency="5" />
            <TextBlock Grid.Column="2" Text="{Binding HoleMinSupportPercent}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Slider Grid.Column="3" Minimum="10" Maximum="100" Value="{Binding HoleMaxSupportPercent}" TickFrequency="5" />
            <TextBlock Grid.Column="4" Text="{Binding HoleMaxSupportPercent}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Grid>

          <Grid ColumnDefinitions="50,*,70" Margin="0,1,0,0">
            <TextBlock Grid.Column="0" Text="拆分度" FontSize="10" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="50" Maximum="100" Value="{Binding HoleSplitSolidityPercent}" TickFrequency="2" />
            <TextBlock Grid.Column="2" Text="{Binding HoleSplitSolidityPercent}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="50,*,30,*,30" Margin="0,1,0,0">
            <TextBlock Grid.Column="0" Text="边线" FontSize="10" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding EdgeMinSupportPercent}" TickFrequency="5" />
            <TextBlock Grid.Column="2" Text="{Binding EdgeMinSupportPercent}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Slider Grid.Column="3" Minimum="0" Maximum="4" Value="{Binding MinEdgesWithSupport}" TickFrequency="1" />
            <TextBlock Grid.Column="4" Text="{Binding MinEdgesWithSupport}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Grid>

          <Separator Margin="0,8,0,0" />
          <CheckBox Content="启用OCR识别 (RapidOCR)" IsChecked="{Binding EnableOcr}" Margin="0,8,0,0" />
          <TextBlock Text="类别列表 (逗号分隔)" FontSize="11" IsVisible="{Binding EnableOcr}" />
          <TextBox Text="{Binding CategoryList}" IsVisible="{Binding EnableOcr}" FontSize="11" />
          <TextBlock Text="文字位置" FontSize="11" IsVisible="{Binding EnableOcr}" Margin="0,4,0,0" />
          <ComboBox SelectedIndex="{Binding OcrTextPositionIndex}" IsVisible="{Binding EnableOcr}" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="框上 Above" />
            <ComboBoxItem Content="框下 Below" />
            <ComboBoxItem Content="框左 Left" />
            <ComboBoxItem Content="框右 Right" />
            <ComboBoxItem Content="框内 Inside" />
          </ComboBox>
          <TextBlock Text="文字范围 (px)" FontSize="11" IsVisible="{Binding EnableOcr}" Margin="0,4,0,0" />
          <NumericUpDown Value="{Binding OcrTextExtent}" Minimum="10" Maximum="200" Increment="5"
                         IsVisible="{Binding EnableOcr}" />

        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" ColumnDefinitions="*,260" Margin="8,0,0,0">
          <Border Grid.Column="0" BorderBrush="#AAAAAA" BorderThickness="1" Background="#222222">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Panel>
                <Image Source="{Binding PreviewImage}" Width="{Binding CanvasWidth}"
                       Height="{Binding CanvasHeight}" Stretch="Uniform"
                       IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ItemsControl ItemsSource="{Binding Overlays}"
                              Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                              Background="Transparent">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Polygon Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                               Fill="Transparent" IsHitTestVisible="False" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding TextOverlays}"
                              Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                              Background="Transparent">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.Styles>
                    <Style Selector="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding X}" />
                      <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                  </ItemsControl.Styles>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                 FontSize="13" FontWeight="Bold" IsHitTestVisible="False" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                        Background="Transparent" IsHitTestVisible="True"
                        PointerPressed="OnCanvasPointerPressed">
                  <Border.ContextMenu>
                    <ContextMenu Opening="OnContextMenuOpening">
                      <MenuItem Header="求取边框HSV色值" Click="OnGetBoxHsv" />
                      <MenuItem Header="计算孔洞面积" Click="OnComputeHoleArea" />
                      <MenuItem Header="测量最小边长" Click="OnMeasureMinSide" />
                    </ContextMenu>
                  </Border.ContextMenu>
                </Border>
              </Panel>
            </ScrollViewer>
          </Border>

          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="拾色" Command="{Binding TogglePickColorCommand}" Padding="8,3" FontSize="11" />
              <Button Content="自动优化阈值" Command="{Binding AutoOptimizeThresholdCommand}" Padding="8,3" FontSize="11" />
              <Button Content="开始检测" Command="{Binding DetectCommand}" Padding="12,4" />
              <Button Content="取消" Command="{Binding CancelCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
              <Button Content="1-二值" Command="{Binding Step0Command}" Padding="8,3" FontSize="11" />
              <Button Content="2-降噪" Command="{Binding Step1Command}" Padding="8,3" FontSize="11" />
              <Button Content="3-保孔" Command="{Binding Step2Command}" Padding="8,3" FontSize="11" />
              <Button Content="4-检测" Command="{Binding Step3Command}" Padding="8,3" FontSize="11" />
            </StackPanel>
            <ProgressBar IsIndeterminate="{Binding IsProcessing}" Height="4" Margin="0,4,0,0"
                         IsVisible="{Binding IsProcessing}" />
            <TextBlock Text="{Binding ProgressText}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

            <TextBlock Text="标注框色彩 (HSV参考)" FontWeight="Bold" Margin="0,8,0,0" />
            <ListBox ItemsSource="{Binding ColorOptions}" MaxHeight="180" Padding="2">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="20,16,24,Auto" Margin="0,1">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Padding="0" />
                    <Rectangle Grid.Column="1" Width="12" Height="12" Fill="{Binding Swatch}" Margin="2,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock FontSize="9" Opacity="0.7">
                        <Run Text="H:" /><Run Text="{Binding HueLow}" /><Run Text="-" /><Run Text="{Binding HueHigh}" />
                      </TextBlock>
                      <TextBlock FontSize="9" Opacity="0.7">
                        <Run Text="S:" /><Run Text="{Binding SatMin}" /><Run Text="-" /><Run Text="{Binding SatMax}" />
                      </TextBlock>
                      <TextBlock FontSize="9" Opacity="0.7">
                        <Run Text="V:" /><Run Text="{Binding ValMin}" /><Run Text="-" /><Run Text="{Binding ValMax}" />
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="◀ 上一张" Command="{Binding PrevCommand}" Padding="8,4" />
              <Button Content="↻ 刷新" Command="{Binding RefreshCommand}" Padding="8,4" />
              <Button Content="下一张 ▶" Command="{Binding NextCommand}" Padding="8,4" />
            </StackPanel>

            <TextBlock Text="显示结果" FontWeight="Bold" Margin="0,8,0,0" />
            <ListBox SelectedIndex="{Binding ViewMode}" HorizontalAlignment="Stretch" Padding="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="0" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Center" />
                  <Setter Property="MinWidth" Value="0" />
                </Style>
                <Style Selector="ListBoxItem:selected">
                  <Setter Property="Background" Value="#007ACC" />
                  <Setter Property="Foreground" Value="White" />
                </Style>
              </ListBox.Styles>
              <ListBoxItem Content="原图"   MinWidth="52" Padding="4,3" />
              <ListBoxItem Content="二值图" MinWidth="52" Padding="4,3" />
              <ListBoxItem Content="降噪图" MinWidth="52" Padding="4,3" />
              <ListBoxItem Content="保孔图" MinWidth="52" Padding="4,3" />
              <ListBoxItem Content="检测"   MinWidth="52" Padding="4,3" />
            </ListBox>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0"
                        IsVisible="{Binding IsDetectionView}">
              <TextBlock Text="叠加" FontSize="11" VerticalAlignment="Center" />
              <ComboBox SelectedIndex="{Binding DisplayMode}" MinWidth="120">
                <ComboBoxItem Content="补色" />
                <ComboBoxItem Content="原色" />
                <ComboBoxItem Content="不显示" />
              </ComboBox>
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="0,4,0,0">
              <TextBlock Grid.Column="0" Text="画布 W" FontSize="11" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Value="{Binding CanvasWidth}" Minimum="200" Maximum="2000" Increment="50" Margin="4,0,0,0" />
              <TextBlock Grid.Column="2" Text="H" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" />
              <NumericUpDown Grid.Column="3" Value="{Binding CanvasHeight}" Minimum="200" Maximum="2000" Increment="50" Margin="4,0,0,0" />
            </Grid>

            <TextBlock Text="检测结果" FontWeight="Bold" Margin="0,8,0,0" />
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" MaxHeight="280">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="90,*">
                    <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="80" Height="60"
                           Stretch="Uniform" Margin="0,1" />
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ImageName}" FontSize="10" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding BoxCount}" FontSize="10"
                                 Foreground="{Binding BoxCount, Converter={x:Static views:BoxCountColorConverter.Instance}}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="日志" FontWeight="Bold" Margin="0,8,0,0" />
            <ListBox ItemsSource="{Binding LogMessages}" FontSize="11" MaxHeight="120">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem Header="检查 Checker">
      <views:CheckerView DataContext="{Binding Checker}" />
    </TabItem>
  </TabControl>
</Window>
