<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BRobbDetector.ViewModels"
        xmlns:views="using:BRobbDetector.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="BRobbDetector.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="BRobbDetector - 标注框颜色检测"
        Width="1100" Height="720">

  <TabControl>
    <TabItem Header="检测 Detection">
      <Grid ColumnDefinitions="300,*" Margin="8">
        <ScrollViewer Grid.Column="0">
        <StackPanel Spacing="8">

          <TextBlock Text="输入目录 (图片)" FontWeight="Bold" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding InputDirectory}" Watermark="Select input folder..." />
            <Button Grid.Column="1" Content="..." Margin="4,0,0,0" Click="OnPickInputDir" />
          </Grid>

          <TextBlock Text="输出目录 (JSON)" FontWeight="Bold" Margin="0,8,0,0" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" Watermark="Select output folder..." />
            <Button Grid.Column="1" Content="..." Margin="4,0,0,0" Click="OnPickOutputDir" />
          </Grid>

          <Separator Margin="0,8,0,0" />
          <TextBlock Text="颜色规则 (标注框颜色)" FontWeight="Bold" Margin="0,8,0,0" />
          <TextBlock Text="类型 (Type)" FontSize="11" />
          <TextBox Text="{Binding TypeName}" />
          <TextBlock Text="饱和度下限 SatMin" FontSize="11" />
          <NumericUpDown Value="{Binding SatMin}" Minimum="0" Maximum="255" Increment="5" />
          <TextBlock Text="明度下限 ValMin" FontSize="11" />
          <NumericUpDown Value="{Binding ValMin}" Minimum="0" Maximum="255" Increment="5" />

          <TextBlock Text="孔洞检测" FontWeight="Bold" Margin="0,8,0,0" />
          <TextBlock Text="最小孔面积 HoleMinArea" FontSize="11" />
          <NumericUpDown Value="{Binding HoleMinArea}" Minimum="50" Maximum="100000" Increment="50" />
          <TextBlock Text="最小边 HoleMinSide (px)" FontSize="11" />
          <NumericUpDown Value="{Binding HoleMinSide}" Minimum="5" Maximum="500" Increment="5" />
          <TextBlock Text="最小填充率 HoleMinFill (%)" FontSize="11" />
          <NumericUpDown Value="{Binding HoleMinFillPercent}" Minimum="10" Maximum="100" Increment="5" />
          <TextBlock Text="最小边支撑 HoleMinSupport (%)" FontSize="11" />
          <NumericUpDown Value="{Binding HoleMinSupportPercent}" Minimum="10" Maximum="100" Increment="5" />
          <TextBlock Text="线开运算长度 LineOpenLen" FontSize="11" />
          <NumericUpDown Value="{Binding LineOpenLength}" Minimum="5" Maximum="50" Increment="5" />

          <Separator Margin="0,8,0,0" />
          <CheckBox Content="启用OCR识别 (RapidOCR)" IsChecked="{Binding EnableOcr}" Margin="0,8,0,0" />
          <TextBlock Text="类别列表 (逗号分隔)" FontSize="11" IsVisible="{Binding EnableOcr}" />
          <TextBox Text="{Binding CategoryList}" IsVisible="{Binding EnableOcr}" FontSize="11" />
          <TextBlock Text="文字位置" FontSize="11" IsVisible="{Binding EnableOcr}" Margin="0,4,0,0" />
          <ComboBox SelectedIndex="{Binding OcrTextPositionIndex}" IsVisible="{Binding EnableOcr}" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="框上 Above" />
            <ComboBoxItem Content="框下 Below" />
            <ComboBoxItem Content="框左 Left" />
            <ComboBoxItem Content="框右 Right" />
            <ComboBoxItem Content="框内 Inside" />
          </ComboBox>
          <TextBlock Text="文字范围 (px)" FontSize="11" IsVisible="{Binding EnableOcr}" Margin="0,4,0,0" />
          <NumericUpDown Value="{Binding OcrTextExtent}" Minimum="10" Maximum="200" Increment="5"
                         IsVisible="{Binding EnableOcr}" />

        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" ColumnDefinitions="*,260" Margin="8,0,0,0">
          <Border Grid.Column="0" BorderBrush="#AAAAAA" BorderThickness="1" Background="#222222">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Panel>
                <Image Source="{Binding PreviewImage}" Width="{Binding CanvasWidth}"
                       Height="{Binding CanvasHeight}" Stretch="Uniform"
                       IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ItemsControl ItemsSource="{Binding Overlays}"
                              Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                              Background="Transparent">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Polygon Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="3"
                               Fill="Transparent" IsHitTestVisible="False" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Panel>
            </ScrollViewer>
          </Border>

          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="开始检测" Command="{Binding DetectCommand}" Padding="12,4" />
              <Button Content="取消" Command="{Binding CancelCommand}" />
            </StackPanel>
            <ProgressBar IsIndeterminate="{Binding IsProcessing}" Height="4" Margin="0,4,0,0"
                         IsVisible="{Binding IsProcessing}" />
            <TextBlock Text="{Binding ProgressText}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

            <TextBlock Text="标注框色彩" FontWeight="Bold" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding ColorOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton IsChecked="{Binding IsSelected}" Margin="0,0,4,4" Padding="4,2">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Rectangle Width="12" Height="12" Fill="{Binding Swatch}" />
                      <TextBlock Text="{Binding Name}" FontSize="11" />
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="◀ 上一张" Command="{Binding PrevCommand}" Padding="8,4" />
              <Button Content="↻ 刷新" Command="{Binding RefreshCommand}" Padding="8,4" />
              <Button Content="下一张 ▶" Command="{Binding NextCommand}" Padding="8,4" />
            </StackPanel>

            <TextBlock Text="显示结果" FontWeight="Bold" Margin="0,8,0,0" />
            <ComboBox SelectedIndex="{Binding DisplayMode}" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="补色 (Complement)" />
              <ComboBoxItem Content="原色 (Original)" />
              <ComboBoxItem Content="不显示 (None)" />
            </ComboBox>

            <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="0,4,0,0">
              <TextBlock Grid.Column="0" Text="画布 W" FontSize="11" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Value="{Binding CanvasWidth}" Minimum="200" Maximum="2000" Increment="50" Margin="4,0,0,0" />
              <TextBlock Grid.Column="2" Text="H" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" />
              <NumericUpDown Grid.Column="3" Value="{Binding CanvasHeight}" Minimum="200" Maximum="2000" Increment="50" Margin="4,0,0,0" />
            </Grid>

            <TextBlock Text="检测结果" FontWeight="Bold" Margin="0,8,0,0" />
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" MaxHeight="280">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ImageName}" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding BoxCount}" FontSize="11"
                               Foreground="{Binding BoxCount, Converter={x:Static views:BoxCountColorConverter.Instance}}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="日志" FontWeight="Bold" Margin="0,8,0,0" />
            <ListBox ItemsSource="{Binding LogMessages}" FontSize="11" MaxHeight="120" />
          </StackPanel>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem Header="检查 Checker">
      <views:CheckerView DataContext="{Binding Checker}" />
    </TabItem>
  </TabControl>
</Window>
