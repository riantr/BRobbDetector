<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BRbboxChecker.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="BRbboxChecker.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="BRbboxChecker - 边界框灰度检查"
        Width="1200" Height="800">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧区域：图像预览 -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <StackPanel>
                <Image x:Name="ImagePreview" 
                       Stretch="{Binding KeepAspectRatio, Converter={StaticResource StretchConverter}}"
                       MinHeight="600"
                       Source="{Binding CurrentImage}"/>
                <TextBlock Text="{Binding InfoText}" 
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 右侧区域：控制面板 -->
        <StackPanel Grid.Column="1" Margin="10" Spacing="10">
            
            <!-- 文件夹选择 -->
            <Button Content="选择图像文件夹" Command="{Binding SelectImageFolderCommand}"/>
            <Button Content="选择标注文件夹" Command="{Binding SelectLabelFolderCommand}"/>
            
            <!-- 导航按钮 -->
            <Grid ColumnDefinitions="1*,1*">
                <Button Grid.Column="0" Content="上一张" Command="{Binding PreviousImageCommand}"/>
                <Button Grid.Column="1" Content="下一张" Command="{Binding NextImageCommand}"/>
            </Grid>
            
            <!-- 排序按钮 -->
            <Grid ColumnDefinitions="1*,1*">
                <Button Grid.Column="0" Content="正排序" Command="{Binding SortAscendingCommand}"/>
                <Button Grid.Column="1" Content="反排序" Command="{Binding SortDescendingCommand}"/>
            </Grid>
            
            <!-- 计算按钮 -->
            <Button Content="计算目标区域灰度均值" Command="{Binding CalculateGrayMeanCommand}"/>
            
            <!-- 进度条 -->
            <ProgressBar IsIndeterminate="{Binding IsCalculating}" 
                         Height="20"
                         IsVisible="{Binding IsCalculating}"/>
            
            <!-- 显示选项 -->
            <CheckBox Content="显示目标" IsChecked="{Binding ShowTarget}"/>
            <CheckBox Content="锁定纵横比" IsChecked="{Binding KeepAspectRatio}"/>
            
            <!-- 文件列表 -->
            <TextBlock Text="文件列表" FontWeight="Bold" Padding="5"/>
            <ListBox ItemsSource="{Binding FileList}"
                     SelectedIndex="{Binding CurrentIndex}"
                     Height="200"/>
            
            <!-- 待删除列表 -->
            <TextBlock Text="待删除列表" FontWeight="Bold" Padding="5"/>
            <ListBox ItemsSource="{Binding DeleteList}"
                     Height="150"/>
            
            <!-- 全部删除按钮 -->
            <Button Content="全部删除" Command="{Binding DeleteAllCommand}"/>
            
        </StackPanel>
    </Grid>

</Window>